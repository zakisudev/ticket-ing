# Copy to compose.env, replace both passwords, then run:
# docker compose --env-file compose.env up -d

ZAKISU_IMAGE=ghcr.io/zakisudev/ticket-ing:latest
APP_PORT=4000
APP_URL=http://localhost:4000

MYSQL_DATABASE=zakisu_tickets
MYSQL_USER=zakisu
# Use URL-safe values because MYSQL_PASSWORD is embedded in DATABASE_URL.
MYSQL_PASSWORD=replace_with_a_long_url_safe_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_password

# Set true when APP_URL is HTTPS. Keep false only for local HTTP use.
COOKIE_SECURE=false
LOG_LEVEL=info
REGISTRATION_MODE=open

