# Zakisu Tickets — environment configuration
# Copy to .env and fill in real values. NEVER commit the filled-in file.

# development | test | production
NODE_ENV=development

# Port the single Node process listens on (API + static SPA in production)
PORT=4000

# MySQL connection string (placeholder — replace with real credentials locally)
DATABASE_URL=mysql://user:password@localhost:3306/zakisu_tickets

# Public URL of the application (used for CORS allowlist)
# Production: https://tickets.zakisu.com
APP_URL=http://localhost:5173

# Allowed browser origin for CORS + Origin checks.
# Defaults to APP_URL when unset.
CORS_ORIGIN=http://localhost:5173

# debug | info | warn | error
LOG_LEVEL=info

# Optional: override the directory of the built SPA served by the API in production.
# Default: <repo>/apps/web/dist
# WEB_DIST=

# Optional: force Secure cookie flag (auto-enabled when NODE_ENV=production).
# COOKIE_SECURE=false

# Login rate limiting (failures allowed per email+IP within the window)
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MS=900000

# Session lifetime in days
SESSION_TTL_DAYS=30

# Test database used by API tests (local dev container; see apps/api tests)
# TEST_DATABASE_URL=mysql://user:password@localhost:3308/zakisu_tickets_test
