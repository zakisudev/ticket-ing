{
  "name": "@zakisu-tickets/api",
  "version": "0.1.0",
  "private": "*",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --enable-source-maps --import tsx src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@zakisu-tickets/shared": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.1",
    "pino": "^9.10.0",
    "pino-http": "^10.4.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.28.1",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
